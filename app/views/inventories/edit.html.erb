
<div class="page-heading">
  <div>
    <h1>Edit Inventory</h1>
    <p>Manage your inventory settings, permissions, and structure.</p>
  </div>
</div>

<div class="inventory-meta">
  <span class="muted-text">Inventory ID</span>
  <strong><%= @inventory.custom_id %></strong>
</div>

<!-- Inventory Details -->
<section class="section-card">
  <h2>Inventory Details</h2>

  <%= form_with model: @inventory, html: { class: "app-form" } do |form| %>
    <div class="form-field">
      <%= form.label :name, "Inventory Name" %>
      <%= form.text_field :name, required: true %>
    </div>

    <div class="form-field">
      <%= form.label :description, "Description" %>
      <%= form.text_area :description %>
    </div>

    <div class="form-field">
      <%= form.label :visibility, "Visibility" %>
      <%= form.select :visibility, [
        ["Private", "private"],
        ["Public", "public"]
      ] %>
    </div>

    <div class="form-actions">
      <%= form.submit "Update Inventory",
          class: "button button-primary" %>
    </div>
  <% end %>
</section>

<!-- Write Access -->
<section class="section-card">
  <h2>Write Access</h2>

  <p>
    Grant registered users permission to create, edit, and delete items
    in this inventory.
  </p>

  <div class="subsection">
    <h3>Grant Access to a User</h3>

    <%= form_with url: inventory_inventory_accesses_path(@inventory),
                  method: :post,
                  html: { class: "app-form" } do %>
      <div class="form-field">
        <%= label_tag :user_identifier, "Search by name or email" %>

        <%= text_field_tag :user_identifier,
            nil,
            list: "available_users",
            placeholder: "Enter user name or email",
            required: true %>

        <datalist id="available_users">
          <% @available_users.each do |user| %>
            <option value="<%= user.email %>"
                    label="<%= user.name %>"></option>
          <% end %>
        </datalist>
      </div>

      <div class="form-actions">
        <%= submit_tag "Grant Write Access",
            class: "button button-primary" %>
      </div>
    <% end %>
  </div>

  <div class="subsection">
    <h3>Users with Write Access</h3>

    <% if @inventory_accesses.any? %>
      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th>Name</th>
              <th>Email</th>
              <th>Action</th>
            </tr>
          </thead>

          <tbody>
            <% @inventory_accesses.each do |access| %>
              <tr>
                <td><strong><%= access.user.name %></strong></td>
                <td><%= access.user.email %></td>
                <td>
                  <%= button_to "Revoke Access",
                      inventory_inventory_access_path(@inventory, access),
                      method: :delete,
                      class: "button button-danger button-small",
                      data: { turbo_confirm: "Revoke this user's access?" } %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty-state compact-empty-state">
        <p>No users have write access yet.</p>
      </div>
    <% end %>
  </div>
</section>

<!-- Categories -->
<section class="section-card">
  <h2>Categories</h2>
  <p>Organize your inventory items into categories.</p>

  <% if @inventory.categories.any? %>
    <div class="resource-list">
      <% @inventory.categories.each do |category| %>
        <div class="resource-card">
          <%= form_with model: [@inventory, category],
                        html: { class: "inline-form" } do |form| %>
            <div class="form-field">
              <%= form.label :name, "Category Name" %>
              <%= form.text_field :name, required: true %>
            </div>

            <%= form.submit "Update",
                class: "button button-secondary button-small" %>
          <% end %>

          <%= button_to "Delete",
              inventory_category_path(@inventory, category),
              method: :delete,
              class: "button button-danger button-small",
              data: { turbo_confirm: "Are you sure?" } %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state compact-empty-state">
      <p>No categories created yet.</p>
    </div>
  <% end %>

  <div class="subsection">
    <h3>Add New Category</h3>

    <%= form_with model: [@inventory, @inventory.categories.new],
                  html: { class: "app-form" } do |form| %>
      <div class="form-field">
        <%= form.label :name, "Category Name" %>
        <%= form.text_field :name, required: true,
            placeholder: "Enter category name" %>
      </div>

      <div class="form-actions">
        <%= form.submit "Add Category",
            class: "button button-primary" %>
      </div>
    <% end %>
  </div>
</section>

<!-- Custom Fields -->
<section class="section-card">
  <h2>Custom Fields</h2>
  <p>Define additional fields for your inventory items.</p>

  <% if @inventory.custom_fields.any? %>
    <div class="resource-list">
      <% @inventory.custom_fields.order(:position).each do |custom_field| %>
        <div class="resource-card">
          <%= form_with model: [@inventory, custom_field],
                        html: { class: "app-form" } do |form| %>
            <div class="form-field">
              <%= form.label :name, "Field Name" %>
              <%= form.text_field :name, required: true %>
            </div>

            <div class="form-field">
              <%= form.label :field_type, "Field Type" %>
              <%= form.select :field_type, [
                ["Text", "text"],
                ["Textarea", "textarea"],
                ["Number", "number"],
                ["Link", "link"],
                ["Boolean", "boolean"]
              ] %>
            </div>

            <div class="form-actions">
              <%= form.submit "Update Custom Field",
                  class: "button button-secondary button-small" %>
            </div>
          <% end %>

          <%= button_to "Delete Custom Field",
              inventory_custom_field_path(@inventory, custom_field),
              method: :delete,
              class: "button button-danger button-small",
              data: { turbo_confirm: "Are you sure?" } %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state compact-empty-state">
      <p>No custom fields created yet.</p>
    </div>
  <% end %>

  <div class="subsection">
    <h3>Add New Custom Field</h3>

    <%= form_with model: [@inventory, @inventory.custom_fields.new],
                  html: { class: "app-form" } do |form| %>
      <div class="form-field">
        <%= form.label :name, "Field Name" %>
        <%= form.text_field :name, required: true,
            placeholder: "Enter field name" %>
      </div>

      <div class="form-field">
        <%= form.label :field_type, "Field Type" %>
        <%= form.select :field_type, [
          ["Text", "text"],
          ["Textarea", "textarea"],
          ["Number", "number"],
          ["Link", "link"],
          ["Boolean", "boolean"]
        ] %>
      </div>

      <div class="form-actions">
        <%= form.submit "Add Custom Field",
            class: "button button-primary" %>
      </div>
    <% end %>
  </div>
</section>

<!-- Tags -->
<section class="section-card">
  <h2>Tags</h2>
  <p>Add tags to make your inventory easier to organize and search.</p>

  <%= form_with url: inventory_inventory_tags_path(@inventory),
                method: :post,
                html: { class: "app-form" } do |form| %>
    <div class="form-field">
      <%= form.label :tag_name, "Tag Name" %>
      <%= form.text_field :tag_name,
          placeholder: "Enter a tag name",
          required: true %>
    </div>

    <div class="form-actions">
      <%= form.submit "Add Tag",
          class: "button button-primary" %>
    </div>
  <% end %>

  <% if @inventory.tags.any? %>
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>Tag</th>
            <th>Action</th>
          </tr>
        </thead>

        <tbody>
          <% @inventory.inventory_tags.includes(:tag).each do |inventory_tag| %>
            <tr>
              <td>
                <span class="badge text-white">
                  <%= inventory_tag.tag.name %>
                </span>
              </td>
              <td>
                <%= button_to "Remove",
                    inventory_inventory_tag_path(@inventory, inventory_tag),
                    method: :delete,
                    class: "button button-danger button-small" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty-state compact-empty-state">
      <p>No tags added yet.</p>
    </div>
  <% end %>
</section>

<div class="page-footer">
  <%= link_to "← Back to Inventories",
      inventories_path,
      class: "button button-secondary" %>
</div>
