
<div class="page-heading">
  <div>
    <h1>Edit Item - <%= @inventory.name %></h1>
    <p>
      Update <strong><%= @item.name %></strong>
      in <strong><%= @inventory.name %></strong>.
    </p>
  </div>
</div>

<section class="form-card">
  <%= form_with model: [@inventory, @item],
                html: { class: "app-form" } do |form| %>

    <%= render "form", form: form %>

    <div class="form-actions">
      <%= form.submit "Update Item",
          class: "button button-primary" %>

      <%= link_to "Cancel",
          inventory_item_path(@inventory, @item),
          class: "button button-secondary" %>
    </div>
  <% end %>
</section>
