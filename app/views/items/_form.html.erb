
<div class="form-field">
  <%= form.label :name, "Item Name" %>
  <%= form.text_field :name,
      required: true,
      placeholder: "Enter item name" %>
</div>

<div class="form-field">
  <%= form.label :description, "Description" %>
  <%= form.text_area :description,
      placeholder: "Describe this item..." %>
</div>

<div class="form-field">
  <%= form.label :category_id, "Category" %>
  <%= form.collection_select :category_id,
      @inventory.categories,
      :id,
      :name,
      { include_blank: "No Category" } %>
  <p class="field-hint">
    Choose a category to organize this item.
  </p>
</div>

<% custom_fields = @inventory.custom_fields.order(:position) %>

<% if custom_fields.any? %>
  <div class="custom-fields-section">
    <div class="subsection-heading">
      <h3>Custom Fields</h3>
      <p>Provide additional information for this item.</p>
    </div>

    <div class="app-form">
      <% custom_fields.each do |custom_field| %>
        <% field_value = @item.custom_field_values[custom_field.id.to_s] %>

        <div class="form-field">
          <%= label_tag "item_custom_field_values_#{custom_field.id}",
              custom_field.name %>

          <% case custom_field.field_type %>
          <% when "text" %>
            <%= text_field_tag "item[custom_field_values][#{custom_field.id}]",
                field_value,
                id: "item_custom_field_values_#{custom_field.id}",
                placeholder: "Enter #{custom_field.name.downcase}" %>

          <% when "textarea" %>
            <%= text_area_tag "item[custom_field_values][#{custom_field.id}]",
                field_value,
                id: "item_custom_field_values_#{custom_field.id}",
                placeholder: "Enter #{custom_field.name.downcase}" %>

          <% when "number" %>
            <%= number_field_tag "item[custom_field_values][#{custom_field.id}]",
                field_value,
                id: "item_custom_field_values_#{custom_field.id}",
                placeholder: "Enter a number" %>

          <% when "link" %>
            <%= url_field_tag "item[custom_field_values][#{custom_field.id}]",
                field_value,
                id: "item_custom_field_values_#{custom_field.id}",
                placeholder: "https://example.com" %>

          <% when "boolean" %>
            <div class="boolean-field">
              <%= hidden_field_tag "item[custom_field_values][#{custom_field.id}]", "0" %>

              <%= check_box_tag "item[custom_field_values][#{custom_field.id}]",
                  "1",
                  field_value == "1" || field_value == true,
                  id: "item_custom_field_values_#{custom_field.id}" %>

              <%= label_tag "item_custom_field_values_#{custom_field.id}",
                  "Yes / Enabled",
                  class: "boolean-label" %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
