<div class="page-heading">
  <div>
    <h1>Manage Users</h1>
    <p>Manage user accounts and permissions across Inventra.</p>
  </div>

  <span class="status-badge">
    <%= pluralize(@users.size, "user") %>
  </span>
</div>

<section class="admin-users-section">
  <% if @users.any? %>
    <div class="table-responsive">
      <table class="admin-users-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Email Address</th>
            <th>Current Role</th>
            <th>Update Role</th>
          </tr>
        </thead>

        <tbody>
          <% @users.each do |user| %>
            <tr>
              <td>
                <strong><%= user.name %></strong>
              </td>

              <td>
                <span class="admin-user-email"><%= user.email %></span>
              </td>

              <td>
                <span class="role-badge role-<%= user.role %>">
                  <%= user.role.humanize %>
                </span>
              </td>

              <td>
                <%= form_with model: [:admin, user],
                              method: :patch,
                              class: "role-update-form" do |form| %>
                  <%= form.select :role,
                      [["User", "user"], ["Admin", "admin"]],
                      {},
                      aria: { label: "Role for #{user.name}" } %>

                  <%= form.submit "Update",
                      class: "button button-primary button-small" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty-state">
      <h2>No users found</h2>
      <p>There are currently no user accounts to manage.</p>
    </div>
  <% end %>
</section>