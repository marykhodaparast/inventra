<%= turbo_frame_tag "discussion_posts" do %>
  <% if discussion_posts.any? %>
    <div class="discussion-post-list">
      <% discussion_posts.each do |post| %>
        <article class="discussion-post-card">
          <div class="discussion-post-header">
            <div class="discussion-author">
              <div class="discussion-avatar">
                <%= post.user.name.to_s.first&.upcase || "U" %>
              </div>

              <div>
                <strong>
                  <%= link_to post.user.name, user_path(post.user) %>
                </strong>

                <time datetime="<%= post.created_at.iso8601 %>">
                  <%= post.created_at.strftime("%b %d, %Y · %H:%M") %>
                </time>
              </div>
            </div>
          </div>

          <div class="discussion-post-content">
            <%= render_markdown(post.content) %>
          </div>

<div class="discussion-post-actions">
  <span class="like-count">
    <%= pluralize(post.discussion_post_likes.size, "Like") %>
  </span>

  <% if logged_in? %>
    <% if post.discussion_post_likes.any? { |like| like.user_id == current_user.id } %>
      <%= button_to "Unlike",
                    inventory_discussion_post_like_path(post.inventory, post),
                    method: :delete,
                    class: "btn btn-sm btn-outline-secondary" %>
    <% else %>
      <%= button_to "Like",
                    inventory_discussion_post_like_path(post.inventory, post),
                    method: :post,
                    class: "btn btn-sm btn-outline-primary" %>
    <% end %>
  <% end %>
</div>

        </article>
      <% end %>
    </div>
  <% else %>
    <div class="discussion-empty-state">
      <h3>No messages yet</h3>
      <p>Be the first to start the conversation!</p>
    </div>
  <% end %>
<% end %>