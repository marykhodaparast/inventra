
<div class="page-heading">
  <div>
    <h1><%= @item.name %></h1>
    <p>
      Item details in
      <strong><%= @inventory.name %></strong>
    </p>
  </div>

  <% if @inventory.writable_by?(current_user) %>
    <div class="page-heading-actions">
      <%= link_to "Edit Item",
          edit_inventory_item_path(@inventory, @item),
          class: "button button-primary" %>

      <%= button_to "Delete Item",
          inventory_item_path(@inventory, @item),
          method: :delete,
          class: "button button-danger",
          form: {
            data: {
              turbo_confirm: "Are you sure you want to delete this item?"
            }
          } %>
    </div>
  <% end %>
</div>

<section class="section-card item-details-card">
  <h2>Item Information</h2>

  <dl class="item-details-list">
    <div class="detail-row">
      <dt>Item Name</dt>
      <dd><%= @item.name %></dd>
    </div>

    <div class="detail-row">
      <dt>Inventory</dt>
      <dd>
        <%= link_to @inventory.name, inventory_items_path(@inventory) %>
      </dd>
    </div>

    <div class="detail-row">
      <dt>Description</dt>
      <dd class="detail-description">
        <%= @item.description.presence || "No description provided." %>
      </dd>
    </div>

    <div class="detail-row">
      <dt>Category</dt>
      <dd>
        <span class="status-badge">
          <%= @item.category&.name || "Uncategorized" %>
        </span>
      </dd>
    </div>
  </dl>
</section>

<% custom_fields = @inventory.custom_fields.order(:position) %>

<% if custom_fields.any? %>
  <section class="section-card item-custom-details">
    <h2>Custom Fields</h2>
    <p>Additional information associated with this item.</p>

    <dl class="item-details-list">
      <% custom_fields.each do |custom_field| %>
        <% value = @item.custom_field_values.to_h[custom_field.id.to_s] %>

        <div class="detail-row">
          <dt><%= custom_field.name %></dt>

          <dd>
            <% if custom_field.field_type == "boolean" %>
              <span class="status-badge">
                <%= value == true || value == "1" ? "Yes" : "No" %>
              </span>
            <% elsif value.present? %>
              <% if custom_field.field_type == "link" && value.match?(/\Ahttps?:\/\//) %>
                <%= link_to value,
                    value,
                    target: "_blank",
                    rel: "noopener noreferrer" %>
              <% else %>
                <%= value %>
              <% end %>
            <% else %>
              <span class="muted-text">Not provided</span>
            <% end %>
          </dd>
        </div>
      <% end %>
    </dl>
  </section>
<% end %>

<div class="page-footer">
  <%= link_to "← Back to Items",
      inventory_items_path(@inventory),
      class: "button button-secondary" %>
</div>
