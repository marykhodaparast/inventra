<h1>Edit Inventory</h1>

<p>
  Inventory ID:
  <strong><%= @inventory.custom_id %></strong>
</p>

<%= form_with model: @inventory do |form| %>
  <div>
    <%= form.label :name, "Inventory Name" %>
    <%= form.text_field :name, required: true %>
  </div>

  <div>
    <%= form.label :description, "Description" %>
    <%= form.text_area :description %>
  </div>

  <div>
    <%= form.label :visibility, "Visibility" %>
    <%= form.select :visibility, [["Private", "private"], ["Public", "public"]] %>
  </div>

  <div>
    <%= form.submit "Update Inventory" %>
  </div>
<% end %>

<hr>

<h2>Write Access</h2>

<p>
  Grant registered users permission to create, edit, and delete items
  in this inventory.
</p>

<h3>Grant Access to a User</h3>

<%= form_with url: inventory_inventory_accesses_path(@inventory), method: :post do %>
  <div>
    <%= label_tag :user_identifier, "Search by name or email" %>

    <%= text_field_tag :user_identifier,
                       nil,
                       list: "available_users",
                       placeholder: "Enter user name or email",
                       required: true %>

    <datalist id="available_users">
      <% @available_users.each do |user| %>
        <option value="<%= user.email %>"
                label="<%= user.name %>"></option>
      <% end %>
    </datalist>
  </div>

  <%= submit_tag "Grant Write Access" %>
<% end %>

<h3>Users with Write Access</h3>

<% if @inventory_accesses.any? %>
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Action</th>
      </tr>
    </thead>

    <tbody>
      <% @inventory_accesses.each do |access| %>
        <tr>
          <td><%= access.user.name %></td>
          <td><%= access.user.email %></td>
          <td>
            <%= button_to "Revoke Access",
                          inventory_inventory_access_path(@inventory, access),
                          method: :delete,
                          data: { turbo_confirm: "Revoke this user's access?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No users have write access yet.</p>
<% end %>

<%= link_to "Back to Inventories", inventories_path %>

<hr>

<h2>Categories</h2>

<% @inventory.categories.each do |category| %>
  <div>
    <%= form_with model: [@inventory, category] do |form| %>
      <%= form.text_field :name, required: true %>
      <%= form.submit "Update Category" %>
    <% end %>

    <%= button_to "Delete Category",
                  inventory_category_path(@inventory, category),
                  method: :delete,
                  data: { turbo_confirm: "Are you sure?" } %>
  </div>
<% end %>

<h3>Add New Category</h3>

<%= form_with model: [@inventory, @inventory.categories.new] do |form| %>
  <div>
    <%= form.label :name, "Category Name" %>
    <%= form.text_field :name, required: true %>
  </div>

  <%= form.submit "Add Category" %>
<% end %>

<hr>

<h2>Custom Fields</h2>

<% @inventory.custom_fields.order(:position).each do |custom_field| %>
  <div>
    <%= form_with model: [@inventory, custom_field] do |form| %>
      <div>
        <%= form.label :name, "Field Name" %>
        <%= form.text_field :name, required: true %>
      </div>

      <div>
        <%= form.label :field_type, "Field Type" %>
        <%= form.select :field_type, [
          ["Text", "text"],
          ["Textarea", "textarea"],
          ["Number", "number"],
          ["Link", "link"],
          ["Boolean", "boolean"]
        ] %>
      </div>

      <%= form.submit "Update Custom Field" %>
    <% end %>

    <%= button_to "Delete Custom Field",
                  inventory_custom_field_path(@inventory, custom_field),
                  method: :delete,
                  data: { turbo_confirm: "Are you sure?" } %>
  </div>
<% end %>

<h3>Add New Custom Field</h3>

<%= form_with model: [@inventory, @inventory.custom_fields.new] do |form| %>
  <div>
    <%= form.label :name, "Field Name" %>
    <%= form.text_field :name, required: true %>
  </div>

  <div>
    <%= form.label :field_type, "Field Type" %>
    <%= form.select :field_type, [
      ["Text", "text"],
      ["Textarea", "textarea"],
      ["Number", "number"],
      ["Link", "link"],
      ["Boolean", "boolean"]
    ] %>
  </div>

  <%= form.submit "Add Custom Field" %>
<% end %>