
<div class="page-heading">
  <div>
    <h1>Inventories</h1>
    <p>Browse and manage your inventories.</p>
  </div>

  <% if logged_in? %>
    <%= link_to "＋ Create New Inventory",
        new_inventory_path,
        class: "button button-primary" %>
  <% end %>
</div>

<% if @inventories.any? %>
  <div class="table-responsive">
    <table class="data-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Inventory ID</th>
          <th>Description</th>
          <th>Creator</th>
          <th>Visibility</th>
          <th>View</th>
          <% if logged_in? %>
            <th>Management</th>
          <% end %>
        </tr>
      </thead>

      <tbody>
        <% @inventories.each do |inventory| %>
          <tr>
            <td><strong><%= inventory.name %></strong></td>
            <td><%= inventory.custom_id %></td>
            <td><%= inventory.description.presence || "—" %></td>
            <td><%= inventory.user.name %></td>
            <td>
              <span class="status-badge">
                <%= inventory.visibility.to_s.humanize %>
              </span>
            </td>
            <td>
              <%= link_to "View Items",
                  inventory_items_path(inventory),
                  class: "table-action" %>
            </td>

            <% if logged_in? %>
              <td>
                <% if current_user.admin? ||
                      inventory.user_id == current_user.id %>
                  <div class="table-actions">
                    <%= link_to "Edit",
                        edit_inventory_path(inventory),
                        class: "button button-secondary button-small" %>

                    <%= button_to "Delete",
                        inventory_path(inventory),
                        method: :delete,
                        class: "button button-danger button-small",
                        data: { turbo_confirm: "Are you sure you want to delete this inventory?" } %>
                  </div>
                <% else %>
                  <span class="muted-text">No access</span>
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <section class="empty-state">
    <h2>No inventories yet</h2>
    <p>There are no inventories available at the moment.</p>

    <% if logged_in? %>
      <%= link_to "Create Your First Inventory",
          new_inventory_path,
          class: "button button-primary" %>
    <% end %>
  </section>
<% end %>
