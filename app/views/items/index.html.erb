<h1><%= @inventory.name %> - Items</h1>

<section id="inventory-statistics">
  <h2>Inventory Statistics</h2>

  <ul>
    <li>Total Items: <%= @statistics[:total_items] %></li>
    <li>Total Categories: <%= @statistics[:total_categories] %></li>
    <li>Total Custom Fields: <%= @statistics[:total_custom_fields] %></li>
    <li>Total Discussion Posts: <%= @statistics[:total_discussion_posts] %></li>
  </ul>
</section>

<%= link_to "Add New Item", new_inventory_item_path(@inventory) %>


<% if @items.any? %>
  <div class="table-responsive">
    <table class="data-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Description</th>
          <th>Category</th>
          <% if @inventory.writable_by?(current_user) %>
            <th>Management</th>
          <% end %>
        </tr>
      </thead>

      <tbody>
        <% @items.each do |item| %>
          <tr>
            <td>
              <%= link_to item.name,
                  inventory_item_path(@inventory, item) %>
            </td>

            <td><%= item.description %></td>

            <td>
              <%= item.category&.name || "Uncategorized" %>
            </td>

            <% if @inventory.writable_by?(current_user) %>
              <td>
                <%= link_to "Edit",
                    edit_inventory_item_path(@inventory, item) %>

                <%= button_to "Delete",
                    inventory_item_path(@inventory, item),
                    method: :delete,
                    form: {
                      data: {
                        turbo_confirm: "Are you sure you want to delete this item?"
                      }
                    } %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p>No items found in this inventory.</p>
<% end %>


<%= render "discussion_posts/discussion" %>

<%= link_to "Back to Inventories", inventories_path %>