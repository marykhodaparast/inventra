<main>
  <h1>Welcome to Inventra</h1>

  <p>
    A smart and collaborative inventory management platform.
  </p>

  <p>
    Organize your inventories, manage items, and collaborate with others.
  </p>

  <% if logged_in? %>
    <p>Welcome, <%= current_user.name %>!</p>

    <%= button_to "Log Out", logout_path, method: :delete %>
  <% else %>
    <%= link_to "Log In", login_path %>
    <%= link_to "Sign Up", new_user_path %>
  <% end %>
</main>