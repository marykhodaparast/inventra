<h1>My Inventories</h1>

<%= link_to "Create New Inventory", new_inventory_path %>

<% if @inventories.any? %>
  <% @inventories.each do |inventory| %>
    <div>
           <h2><%= inventory.name %></h2>

      <p>
        Inventory ID:
        <strong><%= inventory.custom_id %></strong>
      </p>

      <p><%= inventory.description %></p>

      <p>
        Visibility:
        <%= inventory.visibility %>
      </p>

      <%= link_to "View Items", inventory_items_path(inventory) %>
      <%= link_to "Edit", edit_inventory_path(inventory) %>

      <%= button_to "Delete",
                    inventory_path(inventory),
                    method: :delete,
                    data: { turbo_confirm: "Are you sure?" } %>
    </div>
  <% end %>
<% else %>
  <p>You haven't created any inventories yet.</p>
<% end %>