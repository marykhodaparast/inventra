<div class="page-heading">
  <div>
    <h1>Search Results</h1>

    <% if @query.blank? && @tag.nil? %>
      <p>Search inventories and items or explore content by tag.</p>
    <% elsif @tag.present? %>
      <p>
        Inventories and items tagged with:
        <strong><%= @tag.name %></strong>
      </p>
    <% else %>
      <p>
        Results for:
        <strong><%= @query %></strong>
      </p>
    <% end %>
  </div>
</div>

<% if @query.blank? && @tag.nil? %>
  <div class="empty-state search-empty-state">
    <h2>Start your search</h2>
    <p>Enter a search term in the search bar above or select a tag.</p>
  </div>
<% else %>

  <section class="search-results-section">
    <div class="section-heading">
      <h2>Inventories</h2>
      <span class="status-badge">
        <%= pluralize(@inventories.size, "result") %>
      </span>
    </div>

    <% if @inventories.any? %>
      <div class="table-responsive">
        <table>
          <thead>
            <tr>
              <th>Name</th>
              <th>Custom ID</th>
              <th>Description</th>
              <th>Creator</th>
            </tr>
          </thead>

          <tbody>
            <% @inventories.each do |inventory| %>
              <tr>
                <td>
                  <%= link_to inventory.name,
                      inventory_items_path(inventory) %>
                </td>
                <td><%= inventory.custom_id.presence || "—" %></td>
                <td><%= inventory.description.presence || "—" %></td>
                <td><%= inventory.user.name %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="compact-empty-state empty-state">
        <p>No inventories found.</p>
      </div>
    <% end %>
  </section>

  <section class="search-results-section">
    <div class="section-heading">
      <h2>Items</h2>
      <span class="status-badge">
        <%= pluralize(@items.size, "result") %>
      </span>
    </div>

    <% if @items.any? %>
      <div class="table-responsive">
        <table>
          <thead>
            <tr>
              <th>Name</th>
              <th>Description</th>
              <th>Inventory</th>
            </tr>
          </thead>

          <tbody>
            <% @items.each do |item| %>
              <tr>
                <td>
                  <%= link_to item.name,
                      inventory_item_path(item.inventory, item) %>
                </td>
                <td><%= item.description.presence || "—" %></td>
                <td>
                  <%= link_to item.inventory.name,
                      inventory_items_path(item.inventory) %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="compact-empty-state empty-state">
        <p>No items found.</p>
      </div>
    <% end %>
  </section>

<% end %>