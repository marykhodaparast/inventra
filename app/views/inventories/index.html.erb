
<h1>Inventories</h1>

<% if logged_in? %>
  <%= link_to "Create New Inventory", new_inventory_path %>
<% end %>

<% if @inventories.any? %>
  <div class="table-responsive">
    <table class="data-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Inventory ID</th>
          <th>Description</th>
          <th>Creator</th>
          <th>Visibility</th>
          <th>View</th>
          <% if logged_in? %>
            <th>Management</th>
          <% end %>
        </tr>
      </thead>

      <tbody>
        <% @inventories.each do |inventory| %>
          <tr>
            <td><%= inventory.name %></td>
            <td><%= inventory.custom_id %></td>
            <td><%= inventory.description %></td>
            <td><%= inventory.user.name %></td>
            <td><%= inventory.visibility %></td>
            <td>
              <%= link_to "View Items",
                  inventory_items_path(inventory) %>
            </td>

            <% if logged_in? %>
              <td>
                <% if current_user.admin? ||
                      inventory.user_id == current_user.id %>
                  <%= link_to "Edit",
                      edit_inventory_path(inventory) %>

                  <%= button_to "Delete",
                      inventory_path(inventory),
                      method: :delete,
                      data: { turbo_confirm: "Are you sure?" } %>
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p>No inventories available yet.</p>
<% end %>
