<h1>Edit My Profile</h1>

<%= form_with model: @user, url: profile_path, method: :patch do |form| %>
  <div>
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :email %>
    <%= form.email_field :email %>
  </div>

  <div>
    <%= form.label :bio %>
    <%= form.text_area :bio %>
  </div>

  <div>
    <%= form.label :avatar_url %>
    <%= form.url_field :avatar_url %>
  </div>

  <%= form.submit "Save Changes" %>
<% end %>

<%= link_to "Back to Profile", profile_path %>